{
  "expo": {
    "name": "churchConnect",
    "slug": "churchConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "churchconnect",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

{
  "expo": {
    "name": "churchConnect",
    "slug": "churchConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "churchconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.churchconnect.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.churchconnect.app",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58201d62-2f2f-4229-8084-8b0fdae04557"
      }
    },
    "owner": "belend98"
  }
}
